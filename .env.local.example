# Firebase Web
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin (env only — never use FIREBASE_SERVICE_ACCOUNT_PATH on Netlify)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=
# Prefer BASE64 locally and on Netlify (avoids PEM newline paste issues)
FIREBASE_PRIVATE_KEY_BASE64=
# FIREBASE_PRIVATE_KEY=

VERO_SUPER_ADMIN_EMAILS=admin@vero360.app

# PayChangu (bank cash-out and checkout). Mobile-money payouts use PawaPay.
PAYCHANGU_SECRET_KEY=
# PawaPay live merchant API token from https://dashboard.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=live

# Site
NEXT_PUBLIC_SITE_URL=https://vero360.app
NEXT_PUBLIC_ADMIN_URL=https://vero360.app
NEXT_PUBLIC_WHATSAPP_NUMBER=265992695612
NEXT_PUBLIC_VERO_API_BASE=http://67.211.220.69:3000

# App Links / Universal Links (Facebook → app if installed, else website)
# Apple Developer → Membership → Team ID (10 characters)
# APPLE_TEAM_ID=
# Optional: Play Console → App integrity → App signing key certificate SHA-256
# (colon form). Upload keystore SHA is already baked in; add Play signing SHA if different.
# ANDROID_APP_LINK_SHA256=
# Optional: App Store numeric id for Smart Banner + Facebook al:ios:app_store_id
# NEXT_PUBLIC_IOS_APP_STORE_ID=
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX

# PawaPay (server-only — digital services checkout)
# PAWAPAY_API_TOKEN=
# PAWAPAY_ENV=live

# Must match VERO_ADMIN_API_KEY on the Nest backend (vero-backend/.env).
# Used when server routes call /vero/admin/* (Vero Ride driver/vehicle review).
# Optional if the panel forwards the signed-in Firebase ID token instead.
# VERO_ADMIN_API_KEY=
# VERO_API_TOKEN=

# Do not set CAR_HIRE_OPS_KEY here. That secret stays on vero-backend only.

# Contact
CONTACT_TO_EMAIL=info@vero360.app
VEROCHAT_NOTIFY_EMAIL=info@vero360.app
FORMSUBMIT_ID=af3930657a7c20515c4324c017f006ce
